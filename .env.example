# ============================================================
# Telegram Bot
# ============================================================
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Database (postgres в docker-compose)
# ============================================================
POSTGRES_USER=taskbot
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=taskbot
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Async-URL для SQLAlchemy и Alembic
DATABASE_URL=postgresql+asyncpg://taskbot:change_me_in_prod@db:5432/taskbot

# ============================================================
# JWT
# ============================================================
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace_me_with_long_random_string
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=10080

# ============================================================
# API <-> Bot
# ============================================================
API_BASE_URL=http://api:8000/api/v1

# Опционально: защита /auth/telegram от вызовов извне сети.
# Пустое значение = защита отключена (удобно для локального запуска).
SERVICE_KEY=

# ============================================================
# Runtime
# ============================================================
ENVIRONMENT=development
LOG_LEVEL=INFO